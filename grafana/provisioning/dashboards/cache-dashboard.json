{
  "title": "HappyHeadlines — Cache Hit Ratios",
  "uid": "cache-dashboard",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "tags": ["cache", "happyheadlines"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "annotations": { "list": [] },
  "links": [],
  "fiscalYearStartMonth": 0,
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Article Cache Hit Ratio",
      "description": "Percentage of article reads served from Redis rather than the database. Target: > 80%.",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.5  },
              { "color": "green",  "value": 0.8  }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(increase(article_cache_hits_total[15m])) or on() vector(0)) / clamp_min((sum(increase(article_cache_hits_total[15m])) or on() vector(0)) + (sum(increase(article_cache_misses_total[15m])) or on() vector(0)), 1)",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Comment Cache Hit Ratio",
      "description": "Percentage of comment list reads served from Redis rather than the database. Target: > 80%.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.5  },
              { "color": "green",  "value": 0.8  }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(increase(comment_cache_hits_total[15m])) or on() vector(0)) / clamp_min((sum(increase(comment_cache_hits_total[15m])) or on() vector(0)) + (sum(increase(comment_cache_misses_total[15m])) or on() vector(0)), 1)",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "Article Cache — Hits vs Misses (last 15m)",
      "description": "Rolling 15-minute hit and miss counts for ArticleCache. A healthy cache has far more hits than misses.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hits" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Misses" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(increase(article_cache_hits_total[15m])) or on() vector(0)",
          "legendFormat": "Hits",
          "refId": "A"
        },
        {
          "expr": "sum(increase(article_cache_misses_total[15m])) or on() vector(0)",
          "legendFormat": "Misses",
          "refId": "B"
        }
      ]
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Comment Cache — Hits vs Misses (last 15m)",
      "description": "Rolling 15-minute hit and miss counts for CommentCache.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hits" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Misses" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(increase(comment_cache_hits_total[15m])) or on() vector(0)",
          "legendFormat": "Hits",
          "refId": "A"
        },
        {
          "expr": "sum(increase(comment_cache_misses_total[15m])) or on() vector(0)",
          "legendFormat": "Misses",
          "refId": "B"
        }
      ]
    },

    {
      "id": 5,
      "type": "gauge",
      "title": "Comment Cache Size",
      "description": "Number of articles currently held in the CommentCache. Maximum capacity is 30. When full, the least recently used article is evicted.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "Cached Articles",
          "min": 0,
          "max": 30,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 20   },
              { "color": "red",    "value": 28   }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "comment_cache_size_articles",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }

  ],

  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {}
}